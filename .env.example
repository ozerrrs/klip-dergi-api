# Bu dosyayı .env adıyla kopyala ve değerleri doldur:  cp .env.example .env
# .env commit edilmez (gizli bilgi içerir); bu dosya sadece hangi değişkenlerin gerektiğini gösterir.

# API ve Drizzle'ın veritabanına bağlandığı adres (docker-compose.yaml'daki port: 5435)
DATABASE_URL=postgres://KULLANICI:SIFRE@localhost:5435/VERITABANI

# docker-compose.yaml bu değerleri okur. DATABASE_URL'deki bilgilerle aynı olmalı.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
